---
import { type CollectionEntry, getCollection } from "astro:content";
import License from "@components/widgets/License.astro";
import PostFilter from "@components/widgets/PostFilter.astro";
import PostInfo from "@components/widgets/PostInfo.astro";
import { DATE_FORMAT } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import dayjs from "@utils/dayjs";
import Giscus from "@/components/comments/Giscus.astro";
import MainCard from "@/components/MainCard.astro";
import SemanticNeighbors from "@/components/SemanticNeighbors.astro";
import PageViews from "@/components/widgets/PageViews.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  const filteredPosts = import.meta.env.PROD
    ? posts.filter((post: CollectionEntry<"blog">) => !post.data.draft)
    : posts;

  return filteredPosts.map((blog: CollectionEntry<"blog">) => ({
    params: { slug: blog.slug },
    props: { blog },
  }));
}

interface Props {
  blog: CollectionEntry<"blog">;
}

const { blog } = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await blog.render();
const displayDate = blog.data.pubDate
  ? dayjs(blog.data.pubDate).format(DATE_FORMAT)
  : "";
const image = new URL(`/og/${blog.slug}.png`, Astro.site).toString();
const url = new URL(`/blog/${blog.slug}`, Astro.url.origin);
const allPosts = await getCollection("blog");
const visiblePosts = import.meta.env.PROD
  ? allPosts.filter((post) => !post.data.draft)
  : allPosts;
const currentTags = new Set(
  (blog.data.tags || []).map((tag) => tag.toLowerCase()),
);
const currentCategories = new Set(
  (blog.data.categories || []).map((category) => category.toLowerCase()),
);
const titleTerms = new Set(
  blog.data.title.toLowerCase().match(/[a-z0-9]+|[\u4e00-\u9fff]{2,}/g) || [],
);
const relatedPosts = visiblePosts
  .filter((post) => post.slug !== blog.slug)
  .map((post) => {
    const sharedTags = (post.data.tags || []).filter((tag) =>
      currentTags.has(tag.toLowerCase()),
    );
    const sharedCategories = (post.data.categories || []).filter((category) =>
      currentCategories.has(category.toLowerCase()),
    );
    const postTerms = new Set(
      post.data.title.toLowerCase().match(/[a-z0-9]+|[\u4e00-\u9fff]{2,}/g) ||
        [],
    );
    const sharedTerms = [...titleTerms].filter((term) => postTerms.has(term));
    const score =
      sharedTags.length * 6 + sharedCategories.length * 3 + sharedTerms.length;
    return {
      slug: post.slug,
      title: post.data.title,
      description: post.data.description,
      tags: post.data.tags || [],
      score,
      reason: sharedTags.length
        ? `共同标签 · ${sharedTags.slice(0, 2).join("、")}`
        : sharedCategories.length
          ? `同一分类 · ${sharedCategories[0]}`
          : "主题邻近 · 继续探索",
    };
  })
  .sort((left, right) => right.score - left.score)
  .slice(0, 4);
---

<BaseLayout
  title={blog.data.title}
  description={blog.data.description}
  image={image}
  headings={headings}
  showTOC={true}
>
  <MainCard title={blog.data.title} description={blog.data.description} image={blog.data.image} infoIcon="lucide:info" link={blog.data.link}>
    <PostInfo
      pubDate={displayDate}
      badge={blog.data.badge}
      word={remarkPluginFrontmatter.totalCharCount}
      time={remarkPluginFrontmatter.readingTime}
    />

    <div class="mb-6">
      <PostFilter categories={blog.data.categories} tags={blog.data.tags} />
    </div>

    <div class="mt-8">
      <div id="content" class="prose max-w-none prose-headings:scroll-mt-20 prose-img:rounded-xl prose-img:mx-auto">
        <Content />
        <License
          url={url}
          title={blog.data.title}
          image={blog.data.image}
          pubDate={blog.data.pubDate}
          badge={blog.data.badge}
          categories={blog.data.categories}
          tags={blog.data.tags}
          word={remarkPluginFrontmatter.totalCharCount}
          time={remarkPluginFrontmatter.readingTime}
        />
      </div>
    </div>

    <SemanticNeighbors posts={relatedPosts} />

    <PageViews />
    <Giscus />
    
  </MainCard>
</BaseLayout>
