---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const recentPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="庭院"
  description="寒柳别苑，记录学习、制作与思考。"
  seoDescription="柳含知的个人网站，记录智能系统、软件工程、开发者工具、诗歌与写作。"
>
  <MainCard
    title="寒柳别苑"
    description="记录学习、制作与思考。"
    textOverlay="COURTYARD"
    textOverlayClass="whitespace-nowrap text-[clamp(2.5rem,7vw,10rem)]"
    headerImageDark="/portfolio/bg-dark.webp"
    headerImageLight="/portfolio/bg-light.webp"
    infoIcon="lucide:home"
  >
    <div class="space-y-14">
      <section class="py-8 text-center" aria-labelledby="courtyard-welcome">
        <p class="mb-3 font-mono text-xs font-bold uppercase tracking-[0.28em] text-primary">
          Welcome to Hanliu Biyuan
        </p>
        <h2 id="courtyard-welcome" class="mx-auto max-w-3xl text-2xl font-black leading-tight sm:text-4xl">
          欢迎来到寒柳别苑
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-base-content/65 sm:text-lg">
          这里记录我正在做的事：写代码、做实验，也留下还没有想清楚的念头。
        </p>
      </section>

      <section aria-labelledby="host-intro" class="rounded-2xl border border-base-300 bg-base-200 p-6 sm:p-8">
        <div class="grid gap-8 md:grid-cols-[0.85fr_1.5fr] md:items-end">
          <div>
            <p class="font-mono text-xs font-bold uppercase tracking-[0.24em] text-primary">About the host</p>
            <h2 id="host-intro" class="mt-3 text-2xl font-black sm:text-3xl">柳含知 / Zhou Yinlong</h2>
            <p class="mt-2 text-sm text-base-content/55">Online as Liu Hanzhi</p>
          </div>
          <div>
            <p class="text-base leading-7 text-base-content/75 sm:text-lg">
              我在南京大学学习智能科学与技术，平时在智能系统、Agent 工作流、机器人控制和开发者工具之间游走。
            </p>
            <p class="mt-3 text-sm leading-6 text-base-content/55">
              这座别苑是我的公开记录：把做过的东西、读过的文字和还没想清楚的实验放在一起，慢慢整理，也慢慢长出来。
            </p>
            <div class="mt-5 flex flex-wrap gap-2">
              <span class="badge badge-outline">南京大学</span>
              <span class="badge badge-outline">智能科学与技术</span>
              <span class="badge badge-outline">Build in Public</span>
            </div>
          </div>
        </div>
      </section>

      <section aria-labelledby="courtyard-links">
        <div class="mb-6">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/40">Explore</p>
          <h2 id="courtyard-links" class="mt-1 text-2xl font-bold">从这里开始</h2>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {[
            {
              href: "/blog/",
              icon: "lucide:book-open",
              label: "博客",
              description: "技术实践、项目复盘与随笔。",
            },
            {
              href: "/project/",
              icon: "lucide:flask-conical",
              label: "实验室",
              description: "游戏、算法和交互实验。",
            },
            {
              href: "/chores/making/",
              icon: "lucide:hammer",
              label: "造物录",
              description: "项目、工具与工程决策。",
            },
            {
              href: "/garden/",
              icon: "lucide:network",
              label: "语义花园",
              description: "从内容之间的距离重新阅读。",
            },
            {
              href: "/about/",
              icon: "lucide:user-round",
              label: "居士自序",
              description: "关于我，以及这座别苑。",
            },
          ].map((item) => (
            <a
              href={item.href}
              class="group rounded-2xl border border-base-300 bg-base-200 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg"
            >
              <Icon name={item.icon} class="h-6 w-6 text-primary transition-transform duration-300 group-hover:scale-110" />
              <h3 class="mt-5 font-bold">{item.label}</h3>
              <p class="mt-2 text-sm leading-6 text-base-content/60">{item.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-primary">
                进入
                <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5" />
              </span>
            </a>
          ))}
        </div>
      </section>

      <section aria-labelledby="recent-posts-title">
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/40">Recently written</p>
            <h2 id="recent-posts-title" class="mt-1 text-2xl font-bold">最近留下的文字</h2>
          </div>
          <a href="/blog/" class="btn btn-sm btn-ghost gap-2">
            全部文章
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="group rounded-2xl border border-base-300 bg-base-100 p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
              {post.data.image && (
                <div class="mb-5 aspect-video overflow-hidden rounded-xl bg-base-200">
                  <img src={post.data.image} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
              )}
              <p class="font-mono text-xs text-base-content/40">
                {post.data.pubDate.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
              </p>
              <h3 class="mt-3 line-clamp-2 text-lg font-bold group-hover:text-primary">{post.data.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm leading-6 text-base-content/60">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="rounded-2xl border border-primary/25 bg-primary/5 px-6 py-8 text-center sm:px-8">
        <p class="mx-auto max-w-2xl text-sm leading-7 text-base-content/65">
          如果你想聊一个项目、一篇文章，或者某个还没有答案的问题，欢迎给我写信。
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a href="mailto:liuhanzhi514@gmail.com" class="btn btn-sm btn-ghost gap-2">
            写一封信
            <Icon name="lucide:mail" class="h-4 w-4" />
          </a>
        </div>
      </section>
    </div>
  </MainCard>
</BaseLayout>
