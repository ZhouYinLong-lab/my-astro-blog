---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";

const scenes = [
  {
    id: "courtyard",
    label: "01 / 入苑",
    eyebrow: "THE COURTYARD",
    title: "从一张书桌开始",
    body: "别苑的入口。书、纸、砚台和一盏灯，先把外面的喧闹挡在门外。",
    light: "/portfolio/bg-light.webp",
    dark: "/portfolio/bg-dark.webp",
    href: "/",
    cta: "回到庭院",
    accent: "#7d9b56",
    top: 420,
    side: "left",
  },
  {
    id: "about",
    label: "02 / 自序",
    eyebrow: "A NOTE FROM THE HOUSE",
    title: "把人和来信留在这里",
    body: "一间靠近入口的小屋，收下自我介绍、信件、旧照片和还没有被归档的念头。",
    light: "/portfolio/hero-about-light.webp",
    dark: "/portfolio/hero-about-dark.webp",
    href: "/about/",
    cta: "读居士自序",
    accent: "#b27d59",
    top: 880,
    side: "right",
  },
  {
    id: "blog",
    label: "03 / 博客",
    eyebrow: "THE READING ROOM",
    title: "在书架之间整理问题",
    body: "文章不是展品，更像一叠被反复打开的纸：代码、课程、实践和还在长出形状的想法。",
    light: "/portfolio/hero-blog-light.webp",
    dark: "/portfolio/hero-blog-dark.webp",
    href: "/blog/",
    cta: "翻开博客",
    accent: "#7286a0",
    top: 1340,
    side: "left",
  },
  {
    id: "making",
    label: "04 / 造物录",
    eyebrow: "THE WORKBENCH",
    title: "把想法放到桌上",
    body: "项目、工具和失败的原型都从这里经过。先做出来，再决定它值得被怎样命名。",
    light: "/portfolio/hero-build-light.webp",
    dark: "/portfolio/hero-build-dark.webp",
    href: "/chores/making/",
    cta: "看造物录",
    accent: "#a28f4e",
    top: 1810,
    side: "right",
  },
  {
    id: "backyard",
    label: "05 / 杂务",
    eyebrow: "THE BACK GARDEN",
    title: "让零碎的东西继续生长",
    body: "有些记录不属于文章，也暂时不需要结论。它们先放在后院，等下一次路过。",
    light: "/portfolio/hero-work-light.webp",
    dark: "/portfolio/hero-work-dark.webp",
    href: "/backyard/",
    cta: "进入别苑杂务",
    accent: "#668b61",
    top: 2280,
    side: "left",
  },
  {
    id: "garden",
    label: "06 / 语义花园",
    eyebrow: "THE SEMANTIC GARDEN",
    title: "看见内容之间的路",
    body: "文章、项目和学习记录不再只是列表。它们按照相近与相远，慢慢显出一张地图。",
    light: "/portfolio/semantic-garden-light.png",
    dark: "/portfolio/semantic-garden-dark.png",
    href: "/chores/garden/",
    cta: "打开语义花园",
    accent: "#6c9d59",
    top: 2740,
    side: "right",
  },
];

const branchPaths = [
  "M 600 520 L 395 520",
  "M 600 980 L 805 980",
  "M 600 1440 L 395 1440",
  "M 600 1910 L 805 1910",
  "M 600 2380 L 395 2380",
  "M 600 2840 L 805 2840",
];
---

<BaseLayout
  title="别苑世界"
  description="一张沿纵向展开的寒柳别苑微缩地图。"
  seoDescription="寒柳别苑的纵向微缩世界原型。"
  isIndexed={false}
  immersive={true}
  animateType="fade-up"
>
  <div slot="fullscreen" class="world-page" data-world-root>
    <header class="world-topbar">
      <a class="world-mark" href="/" aria-label="返回寒柳别苑庭院">
        <span class="world-mark__seal">寒</span>
        <span>
          <strong>寒柳别苑</strong>
          <small>THE HOUSE MAP / STATIC STUDY</small>
        </span>
      </a>
      <div class="world-topbar__right">
        <span class="world-status"><i></i> 纵向地图</span>
        <a href="/" class="world-back">返回庭院 <Icon name="lucide:arrow-up-right" /></a>
      </div>
    </header>

    <main class="world-scroll">
      <section class="world-map" data-world-map aria-label="寒柳别苑微缩地图">
        <div class="world-map__header">
          <p>HANLIU BIYUAN / A SMALL HOUSE FOR LARGE QUESTIONS</p>
          <h1>沿着别苑的小路<br /><em>慢慢走一圈</em></h1>
          <span>纵向展开 · 共享地面 · 保留原有空间画面</span>
        </div>

        <svg class="world-route" viewBox="0 0 1200 3200" aria-hidden="true">
          <defs>
            <pattern id="world-grid" width="24" height="24" patternUnits="userSpaceOnUse">
              <path d="M24 0H0V24" fill="none" stroke="currentColor" stroke-opacity=".12" stroke-width="1" />
            </pattern>
          </defs>
          <path class="world-route__ground" d="M600 280 C 410 530 790 760 600 1010 S 420 1460 600 1680 S 785 2140 600 2370 S 420 2700 600 3090" />
          <path class="world-route__line" d="M600 280 C 410 530 790 760 600 1010 S 420 1460 600 1680 S 785 2140 600 2370 S 420 2700 600 3090" />
          <path class="world-route__grid" d="M600 280 C 410 530 790 760 600 1010 S 420 1460 600 1680 S 785 2140 600 2370 S 420 2700 600 3090" />
          {branchPaths.map((path) => <path class="world-route__branch" d={path} />)}
          {scenes.map((scene, index) => (
            <g class="world-route__station" transform={`translate(600 ${scene.top + 100})`}>
              <circle r="24" />
              <circle r="9" />
              <text y="5" text-anchor="middle">{index + 1}</text>
            </g>
          ))}
        </svg>

        <div class="world-map__objects" aria-hidden="true">
          <span class="world-tree world-tree--one"></span>
          <span class="world-tree world-tree--two"></span>
          <span class="world-tree world-tree--three"></span>
          <span class="world-bamboo"></span>
          <span class="world-pond"><i>月影池</i></span>
          <span class="world-stone"></span>
        </div>

        {scenes.map((scene, index) => (
          <article
            class:list={["world-scene", scene.side === "right" && "world-scene--right"]}
            data-world-scene={index}
            data-world-id={scene.id}
            style={`--scene-top: ${scene.top}px; --scene-accent: ${scene.accent};`}
          >
            <div class="world-scene__number">{scene.label}</div>
            <div class="world-scene__window">
              <img class="world-scene__image world-scene__image--dark" src={scene.dark} alt="" decoding="async" />
              <img class="world-scene__image world-scene__image--light" src={scene.light} alt="" decoding="async" />
            </div>
            <div class="world-scene__caption">
              <p>{scene.eyebrow}</p>
              <h2>{scene.title}</h2>
              <span>{scene.body}</span>
              <a href={scene.href}>{scene.cta} <Icon name="lucide:arrow-right" /></a>
            </div>
          </article>
        ))}

        <div class="world-map__end">
          <span>THE END OF THIS PATH</span>
          <strong>从这里回到庭院，或者再走一遍。</strong>
          <a href="/">离开别苑世界 <Icon name="lucide:arrow-up-right" /></a>
        </div>
      </section>
    </main>

    <aside class="world-readout" aria-live="polite">
      <div class="world-readout__line"><span data-world-current>01 / 入苑</span><span>SCROLLING MAP</span></div>
      <div class="world-readout__progress"><span data-world-progress></span></div>
    </aside>

    <nav class="world-dots" aria-label="地图区域导航">
      {scenes.map((scene, index) => (
        <button type="button" data-world-dot={index} aria-label={`前往${scene.title}`}>
          <span>{scene.label}</span>
        </button>
      ))}
    </nav>
  </div>
</BaseLayout>

<script>
  const mountWorld = () => {
    const root = document.querySelector("[data-world-root]");
    const map = root?.querySelector("[data-world-map]");
    const progress = root?.querySelector<HTMLElement>("[data-world-progress]");
    const current = root?.querySelector<HTMLElement>("[data-world-current]");
    const scenes = root ? [...root.querySelectorAll("[data-world-scene]")] : [];
    const dots = root ? [...root.querySelectorAll("[data-world-dot]")] : [];

    if (!root || !map || !progress || !current || scenes.length === 0) return;

    let ticking = false;
    let observer;

    const updateProgress = () => {
      const maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      progress.style.width = `${Math.min(Math.max(window.scrollY / maxScroll, 0), 1) * 100}%`;
      ticking = false;
    };

    const requestProgress = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateProgress);
    };

    observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        const index = scenes.indexOf(visible.target);
        if (index < 0) return;
        const label = visible.target.querySelector(".world-scene__number")?.textContent?.trim() || "";
        current.textContent = label;
        dots.forEach((dot, dotIndex) => dot.toggleAttribute("data-active", dotIndex === index));
      },
      { threshold: [0.35, 0.6, 0.85], rootMargin: "-15% 0px -25% 0px" },
    );

    scenes.forEach((scene) => observer.observe(scene));
    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => scenes[index]?.scrollIntoView({ behavior: "smooth", block: "center" }));
    });
    window.addEventListener("scroll", requestProgress, { passive: true });
    window.addEventListener("resize", requestProgress, { passive: true });
    updateProgress();
  };

  document.addEventListener("astro:page-load", mountWorld);
  mountWorld();
</script>

<style is:global>
  :root {
    --world-ink: #1d241e;
    --world-paper: #f0f4e8;
    --world-paper-deep: #dce7d5;
    --world-field: #d0ddc5;
    --world-route: #b9955e;
  }

  html[data-theme-type="dark"] {
    --world-ink: #e9eee5;
    --world-paper: #141a16;
    --world-paper-deep: #202b23;
    --world-field: #26382b;
    --world-route: #756744;
  }

  .world-page { min-height: 100vh; overflow-x: hidden; color: var(--world-ink); background: var(--world-paper); }
  .world-topbar { position: fixed; z-index: 20; inset: 0 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem clamp(1.25rem, 4vw, 4rem); pointer-events: none; }
  .world-topbar > *, .world-topbar a { pointer-events: auto; }
  .world-mark, .world-back, .world-scene a, .world-map__end a { color: inherit; text-decoration: none; }
  .world-mark { display: inline-flex; align-items: center; gap: 0.75rem; }
  .world-mark__seal { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; border: 1px solid currentColor; border-radius: 0.25rem; background: color-mix(in srgb, var(--world-paper) 90%, transparent); font-family: serif; font-size: 1.35rem; box-shadow: 3px 3px 0 color-mix(in srgb, var(--world-ink) 20%, transparent); }
  .world-mark strong, .world-mark small { display: block; }
  .world-mark strong { font-size: 0.95rem; letter-spacing: 0.08em; }
  .world-mark small { margin-top: 0.15rem; color: color-mix(in srgb, var(--world-ink) 55%, transparent); font: 0.55rem/1.2 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.12em; }
  .world-topbar__right { display: flex; align-items: center; gap: 1.2rem; font-size: 0.75rem; }
  .world-status { display: inline-flex; align-items: center; gap: 0.45rem; color: color-mix(in srgb, var(--world-ink) 60%, transparent); }
  .world-status i { display: block; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: #71985b; }
  .world-back, .world-map__end a { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 700; }
  .world-back svg, .world-map__end svg, .world-scene a svg { width: 0.95rem; height: 0.95rem; transition: transform 180ms ease; }
  .world-back:hover svg, .world-map__end a:hover svg, .world-scene a:hover svg { transform: translateX(0.18rem); }

  .world-map { position: relative; width: min(1200px, 100vw); height: 3260px; margin: 0 auto; overflow: hidden; background-color: var(--world-field); background-image: linear-gradient(rgba(255,255,255,0.06), rgba(0,0,0,0.08)), radial-gradient(color-mix(in srgb, var(--world-ink) 16%, transparent) 0.7px, transparent 0.7px); background-size: auto, 7px 7px; }
  .world-map::before { position: absolute; inset: 0 44px; border-right: 1px solid color-mix(in srgb, var(--world-ink) 18%, transparent); border-left: 1px solid color-mix(in srgb, var(--world-ink) 18%, transparent); content: ""; }
  .world-map__header { position: absolute; z-index: 5; top: 115px; left: 74px; max-width: 31rem; }
  .world-map__header p { margin: 0 0 1rem; color: color-mix(in srgb, var(--world-ink) 58%, transparent); font: 0.65rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.16em; }
  .world-map__header h1 { margin: 0; font-size: clamp(2.8rem, 6vw, 6rem); font-weight: 900; line-height: 0.98; letter-spacing: -0.09em; }
  .world-map__header h1 em { color: color-mix(in srgb, var(--world-ink) 50%, transparent); font-style: normal; }
  .world-map__header span { display: block; margin-top: 1.35rem; color: color-mix(in srgb, var(--world-ink) 58%, transparent); font-size: 0.85rem; }
  .world-route { position: absolute; z-index: 1; inset: 0; width: 100%; height: 100%; overflow: visible; color: var(--world-ink); }
  .world-route__ground { fill: none; stroke: color-mix(in srgb, var(--world-route) 55%, transparent); stroke-width: 86; stroke-linecap: square; stroke-linejoin: bevel; }
  .world-route__line { fill: none; stroke: var(--world-route); stroke-width: 66; stroke-linecap: square; stroke-linejoin: bevel; }
  .world-route__grid { fill: none; stroke: color-mix(in srgb, var(--world-ink) 20%, transparent); stroke-width: 2; stroke-dasharray: 2 18; }
  .world-route__branch { fill: none; stroke: var(--world-route); stroke-width: 36; stroke-linecap: square; opacity: 0.88; }
  .world-route__station circle:first-child { fill: var(--world-paper); stroke: var(--world-ink); stroke-width: 5; }
  .world-route__station circle:nth-child(2) { fill: var(--world-route); }
  .world-route__station text { fill: var(--world-ink); font: 700 16px ui-monospace, SFMono-Regular, Consolas, monospace; }

  .world-map__objects { position: absolute; z-index: 2; inset: 0; pointer-events: none; }
  .world-tree { position: absolute; display: block; width: 150px; height: 205px; }
  .world-tree::before { position: absolute; right: 37px; bottom: 0; width: 24px; height: 115px; border: 4px solid #32452f; background: #776047; content: ""; }
  .world-tree::after { position: absolute; top: 0; left: 0; width: 150px; height: 145px; border: 4px solid #32452f; background: #6f8654; clip-path: polygon(50% 0, 73% 19%, 100% 25%, 85% 48%, 98% 73%, 65% 69%, 50% 100%, 30% 70%, 0 76%, 15% 47%, 0 22%, 28% 18%); content: ""; box-shadow: inset 18px -14px 0 rgba(0,0,0,0.13); }
  .world-tree--one { top: 260px; right: 150px; }
  .world-tree--two { top: 1570px; left: 140px; transform: scale(0.72); transform-origin: bottom left; }
  .world-tree--three { top: 2470px; right: 110px; transform: scale(0.8); transform-origin: bottom right; }
  .world-bamboo { position: absolute; top: 690px; left: 150px; width: 140px; height: 250px; border-left: 15px solid #47633e; border-right: 14px solid #5d7948; transform: skewX(-8deg); opacity: 0.9; box-shadow: 48px 0 0 #6d8b52, 92px 15px 0 #48663e; }
  .world-bamboo::after { position: absolute; top: 22px; left: -30px; width: 180px; height: 150px; background: radial-gradient(ellipse at 35% 35%, #7f9b5b 0 12%, transparent 13%), radial-gradient(ellipse at 72% 56%, #607f4d 0 14%, transparent 15%), radial-gradient(ellipse at 30% 74%, #567546 0 14%, transparent 15%); content: ""; }
  .world-pond { position: absolute; right: 145px; bottom: 390px; width: 220px; height: 92px; border: 4px solid #3c5d58; background: #77a29d; clip-path: polygon(8% 22%, 34% 2%, 75% 12%, 100% 46%, 78% 87%, 33% 100%, 0 67%); transform: rotate(-8deg); }
  .world-pond i { position: absolute; right: 28px; bottom: -25px; color: var(--world-ink); font: 700 12px ui-monospace, SFMono-Regular, Consolas, monospace; font-style: normal; }
  .world-stone { position: absolute; top: 2100px; left: 180px; width: 120px; height: 65px; border: 4px solid #465346; background: #84917b; clip-path: polygon(13% 100%, 0 44%, 27% 9%, 75% 0, 100% 45%, 84% 100%); }

  .world-scene { position: absolute; z-index: 3; top: var(--scene-top); left: 78px; display: grid; width: 520px; grid-template-columns: 1fr; gap: 0.55rem; }
  .world-scene--right { right: 78px; left: auto; }
  .world-scene__number { color: var(--scene-accent); font: 700 0.7rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.14em; }
  .world-scene__window { position: relative; width: 520px; aspect-ratio: 16 / 9; overflow: hidden; border: 5px solid var(--world-ink); background: #142019; box-shadow: 12px 12px 0 color-mix(in srgb, var(--world-ink) 22%, transparent); }
  .world-scene__window::after { position: absolute; inset: 0; border: 1px solid rgba(255,255,255,0.24); content: ""; pointer-events: none; }
  .world-scene__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; image-rendering: auto; }
  .world-scene__image--dark { display: block; }
  .world-scene__image--light { display: none; }
  html[data-theme-type="light"] .world-scene__image--dark { display: none; }
  html[data-theme-type="light"] .world-scene__image--light { display: block; }
  .world-scene__caption { display: grid; grid-template-columns: 1fr auto; gap: 0.35rem 1rem; max-width: 500px; padding: 0.7rem 0 0.3rem 0.75rem; border-left: 5px solid var(--scene-accent); }
  .world-scene__caption p { grid-column: 1 / -1; margin: 0; color: color-mix(in srgb, var(--world-ink) 56%, transparent); font: 0.62rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.13em; }
  .world-scene__caption h2 { margin: 0; font-size: clamp(1.25rem, 2.5vw, 2rem); font-weight: 900; line-height: 1.05; letter-spacing: -0.06em; }
  .world-scene__caption span { grid-column: 1 / -1; max-width: 34rem; color: color-mix(in srgb, var(--world-ink) 65%, transparent); font-size: 0.82rem; line-height: 1.65; }
  .world-scene__caption a { display: inline-flex; align-items: center; align-self: end; gap: 0.35rem; color: var(--world-ink); font-size: 0.75rem; font-weight: 800; white-space: nowrap; }

  .world-map__end { position: absolute; z-index: 4; right: 0; bottom: 120px; left: 0; display: grid; place-items: center; gap: 0.6rem; text-align: center; }
  .world-map__end span { color: color-mix(in srgb, var(--world-ink) 50%, transparent); font: 0.65rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.16em; }
  .world-map__end strong { font-size: 1.4rem; }
  .world-map__end a { margin-top: 0.5rem; font-size: 0.8rem; }
  .world-readout { position: fixed; z-index: 15; right: clamp(1.25rem, 4vw, 4rem); bottom: 1.3rem; left: clamp(1.25rem, 4vw, 4rem); padding: 0.7rem 0.9rem; color: var(--world-paper); background: color-mix(in srgb, #18231b 86%, transparent); box-shadow: 4px 4px 0 rgba(0,0,0,0.18); backdrop-filter: blur(8px); }
  .world-readout__line { display: flex; justify-content: space-between; gap: 1rem; font: 0.62rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.12em; }
  .world-readout__line span:first-child { color: #c2d69b; }
  .world-readout__line span:last-child { opacity: 0.62; }
  .world-readout__progress { height: 2px; margin-top: 0.55rem; overflow: hidden; background: rgba(255,255,255,0.22); }
  .world-readout__progress span { display: block; width: 0; height: 100%; background: #c2d69b; }
  .world-dots { position: fixed; z-index: 15; top: 50%; right: 1.25rem; display: grid; gap: 0.55rem; transform: translateY(-50%); }
  .world-dots button { position: relative; width: 0.62rem; height: 0.62rem; padding: 0; border: 1px solid var(--world-paper); border-radius: 50%; background: transparent; cursor: pointer; }
  .world-dots button span { position: absolute; right: 1.15rem; top: 50%; width: max-content; transform: translateY(-50%); opacity: 0; color: var(--world-paper); font: 0.62rem ui-monospace, SFMono-Regular, Consolas, monospace; transition: opacity 180ms ease; }
  .world-dots button:hover span, .world-dots button[data-active] span { opacity: 1; }
  .world-dots button[data-active] { background: var(--world-paper); box-shadow: 0 0 0 0.22rem rgba(255,255,255,0.15); }

  @media (max-width: 700px) {
    .world-topbar { align-items: flex-start; padding-top: 4.4rem; }
    .world-topbar__right { align-items: flex-end; flex-direction: column; gap: 0.45rem; }
    .world-status { display: none; }
    .world-mark small { max-width: 8rem; line-height: 1.4; }
    .world-map { height: 3260px; }
    .world-map__header { top: 120px; right: 1.25rem; left: 1.25rem; }
    .world-map__header h1 { font-size: clamp(2.6rem, 13vw, 4rem); }
    .world-map__header span { font-size: 0.72rem; }
    .world-scene, .world-scene--right { right: 1.25rem; left: 1.25rem; width: auto; }
    .world-scene__window { width: 100%; box-shadow: 7px 7px 0 color-mix(in srgb, var(--world-ink) 22%, transparent); }
    .world-scene__caption { max-width: 100%; }
    .world-scene__caption h2 { font-size: 1.45rem; }
    .world-scene__caption span { font-size: 0.78rem; }
    .world-route__branch { stroke-width: 26; }
    .world-tree--one { right: 20px; transform: scale(0.62); transform-origin: top right; }
    .world-tree--two { left: -15px; transform: scale(0.52); }
    .world-tree--three { right: -20px; transform: scale(0.55); }
