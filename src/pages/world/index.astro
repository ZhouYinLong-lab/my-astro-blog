---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ThemeToggle from "@components/widgets/ThemeToggle.astro";

// Bounds refer to the complete 1536 × 1024 illustration, including its margin.
const rooms = [
  { id: "home", label: "首页", href: "/", x: 16, y: 71, w: 14, h: 18 },
  { id: "blog", label: "博客", href: "/blog/", x: 48, y: 13, w: 25, h: 27 },
  { id: "chores", label: "别苑杂务", href: "/chores/", x: 11, y: 53, w: 15, h: 13 },
  { id: "making", label: "造物录", href: "/chores/making/", x: 8, y: 35, w: 20, h: 18 },
  { id: "garden", label: "语义花园", href: "/chores/garden/", x: 14, y: 9, w: 21, h: 24 },
  { id: "about", label: "居士自序", href: "/about/", x: 81, y: 23, w: 15, h: 16 },
  { id: "friends", label: "友链", href: "/friend/", x: 8, y: 79, w: 9, h: 13 },
  { id: "backyard", label: "会客间", href: "/backyard/", x: 71, y: 49, w: 20, h: 24 },
];
---

<BaseLayout
  title="别苑导航"
  description="一座可以走进去的寒柳别苑。"
  seoDescription="沿着曲径、石拱桥与临水书房，探索寒柳别苑的八处地点。"
  bgImage=""
  bgImageLight=""
  isIndexed={false}
  immersive={true}
  hideNavigation={true}
  animateType="fade-up"
>
  <div slot="fullscreen" class="world-page">
    <div class="world-controls" aria-label="世界页面控制">
      <ThemeToggle className="world-theme-toggle" />
      <a class="world-back" href="/" aria-label="返回首页">返回庭院</a>
    </div>
    <main class="world-main">
      <section class="estate-frame" aria-label="寒柳别苑园林导航地图">
        <div class="estate-scene">
          <img
            class="estate-map"
            src="/world/estate-garden.webp"
            width="1536"
            height="1024"
            alt="寒柳别苑：花园与工坊位于左侧，临水书房居后，右侧居室和会客亭由廊道与石拱桥相连，池畔有垂柳与水鸟。"
            loading="eager"
            fetchpriority="high"
          />
          {rooms.map((room) => (
            <a
              class={`room-hit room-hit--${room.id}`}
              style={`left:${room.x}%;top:${room.y}%;width:${room.w}%;height:${room.h}%;`}
              href={room.href}
              aria-label={`进入${room.label}`}
              title={`进入${room.label}`}
            ><span class="sr-only">{room.label}</span></a>
          ))}
        </div>
      </section>
      <nav class="world-mobile-nav" aria-label="别苑地点快捷入口">
        {rooms.map((room) => <a href={room.href}>{room.label}</a>)}
      </nav>
    </main>
  </div>
</BaseLayout>

<style>
  .world-page {
    min-height: 100svh;
    color: #493f30;
    background: #f3ebdd;
  }
  .world-controls {
    position: fixed;
    z-index: 20;
    top: max(.75rem, env(safe-area-inset-top));
    right: max(.75rem, env(safe-area-inset-right));
    display: flex;
    align-items: center;
    gap: .5rem;
  }
  .world-controls :global(.world-theme-toggle), .world-back {
    border: 1px solid #86745255;
    color: #493f30;
    background: #f7f0e3e8;
    backdrop-filter: blur(8px);
  }
  .world-back {
    padding: .6rem .8rem;
    border-radius: .5rem;
    font: 600 .8rem/1.2 serif;
    text-decoration: none;
  }
  .world-back:hover, .world-back:focus-visible {
    background: #fff8e9;
    outline: 2px solid #8b6a3c;
    outline-offset: 2px;
  }
  .world-main {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .estate-frame {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  /* Image and links share one uncropped 3:2 coordinate space at every size. */
  .estate-scene {
    position: relative;
    flex: none;
    width: min(100%, 150svh);
    aspect-ratio: 3 / 2;
  }
  .estate-map { display: block; width: 100%; height: 100%; }
  .room-hit {
    position: absolute;
    z-index: 1;
    display: block;
    border-radius: .65rem;
    cursor: pointer;
    transition: background-color 160ms ease, box-shadow 160ms ease;
  }
  .room-hit:focus-visible {
    outline: 2px solid #79572d;
    outline-offset: 2px;
    background: #fff4cf26;
  }
  @media (hover: hover) {
    .room-hit:hover {
      background: #fff4cf18;
      box-shadow: inset 0 0 0 1px #9b783e70, 0 0 16px #c59e4e24;
    }
  }
  .room-hit:active { background: #efd58e38; }
  .world-mobile-nav { display: none; }
  @media (max-width: 767px) and (orientation: portrait) {
    .world-main { padding: 4.5rem 0 2rem; gap: 1.5rem; }
    .world-mobile-nav {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .5rem;
      width: min(100% - 2rem, 30rem);
      margin: 0 auto;
    }
    .world-mobile-nav a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: .4rem .15rem;
      border: 1px solid #86745240;
      border-radius: .4rem;
      color: #493f30;
      background: #faf4e8;
      font: 600 .8rem/1.4 serif;
      text-decoration: none;
    }
    .world-mobile-nav a:focus-visible {
      outline: 2px solid #79572d;
      outline-offset: 2px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .room-hit { transition: none; }
  }
</style>
