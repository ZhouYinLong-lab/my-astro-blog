---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";

const scenes = [
  {
    id: "courtyard",
    label: "01 / 入苑",
    eyebrow: "THE COURTYARD",
    title: "从一张书桌开始",
    body: "别苑的入口。书、纸、砚台和一盏灯，先把外面的喧闹挡在门外。",
    light: "/portfolio/bg-light.webp",
    dark: "/portfolio/bg-dark.webp",
    href: "/",
    cta: "回到庭院",
    accent: "#789450",
    x: 330,
    y: 720,
  },
  {
    id: "about",
    label: "02 / 自序",
    eyebrow: "A NOTE FROM THE HOUSE",
    title: "把人和来信留在这里",
    body: "一间靠近入口的小屋，收下自我介绍、信件、旧照片和还没有被归档的念头。",
    light: "/portfolio/hero-about-light.webp",
    dark: "/portfolio/hero-about-dark.webp",
    href: "/about/",
    cta: "读居士自序",
    accent: "#b27d59",
    x: 650,
    y: 455,
  },
  {
    id: "blog",
    label: "03 / 博客",
    eyebrow: "THE READING ROOM",
    title: "在书架之间整理问题",
    body: "文章不是展品，更像一叠被反复打开的纸：代码、课程、实践和还在长出形状的想法。",
    light: "/portfolio/hero-blog-light.webp",
    dark: "/portfolio/hero-blog-dark.webp",
    href: "/blog/",
    cta: "翻开博客",
    accent: "#7286a0",
    x: 990,
    y: 300,
  },
  {
    id: "making",
    label: "04 / 造物录",
    eyebrow: "THE WORKBENCH",
    title: "把想法放到桌上",
    body: "项目、工具和失败的原型都从这里经过。先做出来，再决定它值得被怎样命名。",
    light: "/portfolio/hero-build-light.webp",
    dark: "/portfolio/hero-build-dark.webp",
    href: "/chores/making/",
    cta: "看造物录",
    accent: "#a28f4e",
    x: 1260,
    y: 680,
  },
  {
    id: "backyard",
    label: "05 / 杂务",
    eyebrow: "THE BACK GARDEN",
    title: "让零碎的东西继续生长",
    body: "有些记录不属于文章，也暂时不需要结论。它们先放在后院，等下一次路过。",
    light: "/portfolio/hero-work-light.webp",
    dark: "/portfolio/hero-work-dark.webp",
    href: "/backyard/",
    cta: "进入别苑杂务",
    accent: "#668b61",
    x: 1580,
    y: 420,
  },
  {
    id: "garden",
    label: "06 / 语义花园",
    eyebrow: "THE SEMANTIC GARDEN",
    title: "看见内容之间的路",
    body: "文章、项目和学习记录不再只是列表。它们按照相近与相远，慢慢显出一张地图。",
    light: "/portfolio/semantic-garden-light.png",
    dark: "/portfolio/semantic-garden-dark.png",
    href: "/chores/garden/",
    cta: "打开语义花园",
    accent: "#6c9d59",
    x: 1980,
    y: 690,
  },
];

const routePath = scenes.map((scene) => `${scene.x},${scene.y - 65}`).join(" ");
---

<BaseLayout
  title="别苑世界"
  description="一座由寒柳别苑现有图像资源组成的固定等距微缩世界。"
  seoDescription="寒柳别苑的固定等距微缩世界原型。"
  isIndexed={false}
  immersive={true}
  animateType="fade-up"
>
  <div slot="fullscreen" class="world-page" data-world-root data-scene-count={scenes.length}>
    <header class="world-topbar">
      <a class="world-mark" href="/" aria-label="返回寒柳别苑庭院">
        <span class="world-mark__seal">寒</span>
        <span>
          <strong>寒柳别苑</strong>
          <small>MICRO WORLD / STATIC PROTOTYPE</small>
        </span>
      </a>
      <div class="world-topbar__right">
        <span class="world-status"><i></i> 固定等距镜头</span>
        <a href="/" class="world-back">返回庭院 <Icon name="lucide:arrow-up-right" /></a>
      </div>
    </header>

    <section class="world-scroll" data-world-scroll style={`height: ${scenes.length * 110}vh;`}>
      <div class="world-stage">
        <div class="world-camera" data-world-camera>
          <div class="world-map">
            <svg class="world-map__terrain" viewBox="0 0 2400 1400" aria-hidden="true">
              <defs>
                <pattern id="world-pixel-grid" width="18" height="18" patternUnits="userSpaceOnUse">
                  <path d="M18 0H0V18" fill="none" stroke="currentColor" stroke-opacity=".1" stroke-width="1" />
                </pattern>
                <pattern id="world-dither" width="8" height="8" patternUnits="userSpaceOnUse">
                  <circle cx="1" cy="1" r="1" fill="currentColor" fill-opacity=".14" />
                  <circle cx="5" cy="5" r="1" fill="currentColor" fill-opacity=".08" />
                </pattern>
              </defs>
              <polygon class="world-terrain__shadow" points="120,755 1195,180 2295,735 1210,1260" />
              <polygon class="world-terrain__floor" points="90,720 1195,130 2310,705 1200,1290" />
              <polygon class="world-terrain__grid" points="90,720 1195,130 2310,705 1200,1290" fill="url(#world-pixel-grid)" />
              <path class="world-terrain__ridge" d="M145 704L1195 160L2260 708" />
              <path class="world-route__shadow" d={`M ${routePath}`} />
              <path class="world-route" d={`M ${routePath}`} />
              {scenes.map((scene, index) => (
                <g class="world-map__marker" transform={`translate(${scene.x} ${scene.y - 65})`}>
                  <circle r="18" />
                  <text y="5" text-anchor="middle">{index + 1}</text>
                </g>
              ))}
            </svg>

            <div class="world-prop world-prop--bamboo" style="left: 170px; top: 520px;">
              <i></i><i></i><i></i><i></i><i></i>
              <span></span><span></span><span></span><span></span>
            </div>
            <div class="world-prop world-prop--tree" style="left: 440px; top: 235px;"><span></span><i></i></div>
            <div class="world-prop world-prop--tree world-prop--tree-small" style="left: 1770px; top: 210px;"><span></span><i></i></div>
            <div class="world-prop world-prop--pond" style="left: 1770px; top: 920px;"><span>月影池</span></div>
            <div class="world-prop world-prop--stone" style="left: 1030px; top: 900px;"><span></span><i></i></div>

            {scenes.map((scene) => (
              <article
                class="world-room"
                data-world-scene={scene.id}
                style={`--room-x: ${scene.x}px; --room-y: ${scene.y}px; --room-accent: ${scene.accent};`}
              >
                <div class="world-room__shadow"></div>
                <div class="world-room__building">
                  <div class="world-room__roof"></div>
                  <div class="world-room__body">
                    <div class="world-room__image-frame">
                      <img class="world-room__image world-room__image--dark" src={scene.dark} alt="" decoding="async" />
                      <img class="world-room__image world-room__image--light" src={scene.light} alt="" decoding="async" />
                    </div>
                    <div class="world-room__window"></div>
                  </div>
                  <div class="world-room__steps"><i></i><i></i><i></i></div>
                </div>
                <div class="world-room__label">
                  <span>{scene.label}</span>
                  <strong>{scene.eyebrow}</strong>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="world-overlay">
          <div class="world-overlay__intro">
            <p class="world-overlay__kicker">A SMALL HOUSE FOR LARGE QUESTIONS</p>
            <h1>沿着别苑<br /><em>慢慢走一圈</em></h1>
            <p class="world-overlay__note">这不是一组并排的封面，而是一张共享地面、道路和光线的地图。向下滚动，镜头会沿着院中的小路前进。</p>
          </div>

          <div class="world-overlay__current">
            {scenes.map((scene, index) => (
              <article data-world-copy={index}>
                <p><span>{scene.label}</span> {scene.eyebrow}</p>
                <h2>{scene.title}</h2>
                <a href={scene.href}>{scene.cta} <Icon name="lucide:arrow-right" /></a>
              </article>
            ))}
          </div>

          <div class="world-chrome" aria-hidden="true">
            <div class="world-progress"><span data-world-progress></span></div>
            <div class="world-progress-label"><span data-world-current>01</span> / {String(scenes.length).padStart(2, "0")}</div>
          </div>

          <div class="world-dots" aria-label="场景导航">
            {scenes.map((scene, index) => (
              <button type="button" data-world-dot={index} aria-label={`前往${scene.title}`}>
                <span>{scene.label}</span>
              </button>
            ))}
          </div>

          <div class="world-scroll-hint" data-world-hint>
            <span>向下滚动，沿着小路前行</span>
            <Icon name="lucide:arrow-down" />
          </div>
        </div>
      </div>
    </section>

    <footer class="world-footer">
      <span>STATIC STUDY · 一个共享空间关系的无视频原型</span>
      <a href="/">离开世界 <Icon name="lucide:arrow-up-right" /></a>
    </footer>
  </div>
</BaseLayout>

<script define:vars={{ scenes }}>
  const mountWorld = () => {
    const root = document.querySelector("[data-world-root]");
    const scrollSpace = root?.querySelector("[data-world-scroll]");
    const camera = root?.querySelector("[data-world-camera]");
    const current = root?.querySelector("[data-world-current]");
    const progress = root?.querySelector("[data-world-progress]");
    const hint = root?.querySelector("[data-world-hint]");
    const dots = root ? [...root.querySelectorAll("[data-world-dot]")] : [];
    const copies = root ? [...root.querySelectorAll("[data-world-copy]")] : [];

    if (!root || !scrollSpace || !camera || !current || !progress || scenes.length < 2) return;

    const points = scenes.map((scene) => ({ x: scene.x, y: scene.y }));
    let ticking = false;

    const update = () => {
      const bounds = scrollSpace.getBoundingClientRect();
      const travel = Math.max(scrollSpace.offsetHeight - window.innerHeight, 1);
      const rawProgress = Math.min(Math.max(-bounds.top / travel, 0), 1);
      const scenePosition = rawProgress * (points.length - 1);
      const segment = Math.min(Math.floor(scenePosition), points.length - 2);
      const localProgress = scenePosition - segment;
      const from = points[segment];
      const to = points[Math.min(segment + 1, points.length - 1)];
      const x = from.x + (to.x - from.x) * localProgress;
      const y = from.y + (to.y - from.y) * localProgress;
      const activeScene = Math.min(Math.round(scenePosition), points.length - 1);
      const scale = Math.min(0.92, Math.max(0.54, Math.min(window.innerWidth / 1900, window.innerHeight / 1060)));
      const offsetX = window.innerWidth / 2 - x * scale;
      const offsetY = window.innerHeight / 2 - y * scale + (window.innerWidth < 700 ? 60 : 20);

      camera.style.transform = `translate3d(${offsetX}px, ${offsetY}px, 0) scale(${scale})`;
      progress.style.transform = `scaleX(${rawProgress})`;
      current.textContent = String(activeScene + 1).padStart(2, "0");
      root.dataset.activeScene = String(activeScene);

      dots.forEach((dot, index) => dot.toggleAttribute("data-active", index === activeScene));
      copies.forEach((copy, index) => copy.toggleAttribute("data-active", index === activeScene));
      if (hint) hint.toggleAttribute("data-hidden", rawProgress > 0.04);
      ticking = false;
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        const target = scrollSpace.offsetTop + (scrollSpace.offsetHeight - window.innerHeight) * (index / (points.length - 1));
        window.scrollTo({ top: target, behavior: "smooth" });
      });
    });

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate, { passive: true });
    update();
  };

  document.addEventListener("astro:page-load", mountWorld);
  mountWorld();
</script>

<style is:global>
  :root {
    --world-ink: #1a211b;
    --world-paper: #eef3e8;
    --world-paper-deep: #d9e2d1;
    --world-floor: #b7c9a9;
    --world-floor-dark: #27382d;
    --world-line: rgba(26, 33, 27, 0.34);
    --world-shadow: rgba(10, 18, 12, 0.26);
  }

  html[data-theme-type="dark"] {
    --world-ink: #eef1e8;
    --world-paper: #141a17;
    --world-paper-deep: #1d2922;
    --world-floor: #304437;
    --world-floor-dark: #101612;
    --world-line: rgba(238, 241, 232, 0.28);
    --world-shadow: rgba(0, 0, 0, 0.48);
  }

  .world-page { min-height: 100vh; overflow: hidden; color: var(--world-ink); background: var(--world-paper); font-family: inherit; }
  .world-topbar { position: fixed; z-index: 20; inset: 0 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem clamp(1.25rem, 4vw, 4rem); pointer-events: none; }
  .world-topbar > *, .world-topbar a { pointer-events: auto; }
  .world-mark, .world-back, .world-footer a { color: inherit; text-decoration: none; }
  .world-mark { display: inline-flex; align-items: center; gap: 0.75rem; }
  .world-mark__seal { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; border: 1px solid currentColor; border-radius: 0.35rem; background: color-mix(in srgb, var(--world-paper) 82%, transparent); font-family: serif; font-size: 1.35rem; box-shadow: 0 0.3rem 1rem var(--world-shadow); }
  .world-mark strong, .world-mark small { display: block; }
  .world-mark strong { font-size: 0.95rem; letter-spacing: 0.08em; }
  .world-mark small { margin-top: 0.15rem; color: color-mix(in srgb, var(--world-ink) 55%, transparent); font: 0.55rem/1.2 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.12em; }
  .world-topbar__right { display: flex; align-items: center; gap: 1.2rem; font-size: 0.75rem; }
  .world-status { display: inline-flex; align-items: center; gap: 0.45rem; color: color-mix(in srgb, var(--world-ink) 60%, transparent); }
  .world-status i { display: block; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: #71985b; box-shadow: 0 0 0 0.25rem color-mix(in srgb, #71985b 18%, transparent); }
  .world-back, .world-footer a { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 700; }
  .world-back svg, .world-footer svg { width: 0.95rem; height: 0.95rem; transition: transform 180ms ease; }
  .world-back:hover svg, .world-footer a:hover svg { transform: translate(0.15rem, -0.15rem); }

  .world-stage { position: sticky; top: 0; height: 100vh; overflow: hidden; isolation: isolate; background: var(--world-floor-dark); }
  .world-stage::before { position: absolute; z-index: 1; inset: 0; background: radial-gradient(ellipse at center, transparent 35%, color-mix(in srgb, var(--world-floor-dark) 38%, transparent) 100%); content: ""; pointer-events: none; }
  .world-stage::after { position: absolute; z-index: 1; inset: 0; opacity: 0.16; background-image: radial-gradient(color-mix(in srgb, var(--world-ink) 30%, transparent) 0.7px, transparent 0.7px); background-size: 5px 5px; content: ""; mix-blend-mode: screen; pointer-events: none; }
  .world-camera { position: absolute; z-index: 2; top: 0; left: 0; width: 2400px; height: 1400px; transform-origin: 0 0; will-change: transform; }
  .world-map { position: relative; width: 2400px; height: 1400px; }
  .world-map__terrain { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .world-terrain__shadow { fill: rgba(0, 0, 0, 0.32); transform: translate(0 24px); }
  .world-terrain__floor { fill: var(--world-floor); stroke: color-mix(in srgb, var(--world-ink) 30%, transparent); stroke-width: 6; }
  .world-terrain__grid { fill: url(#world-pixel-grid); color: var(--world-ink); }
  .world-terrain__ridge { fill: none; stroke: color-mix(in srgb, var(--world-ink) 24%, transparent); stroke-width: 12; stroke-linecap: square; }
  .world-route__shadow { fill: none; stroke: rgba(0, 0, 0, 0.26); stroke-width: 50; stroke-linecap: square; stroke-linejoin: bevel; transform: translate(0 15px); }
  .world-route { fill: none; stroke: #b49a64; stroke-width: 38; stroke-linecap: square; stroke-linejoin: bevel; stroke-dasharray: 2 22; }
  html[data-theme-type="dark"] .world-route { stroke: #756b47; }
  .world-map__marker circle { fill: var(--world-paper); stroke: var(--world-ink); stroke-width: 5; }
  .world-map__marker text { fill: var(--world-ink); font: 700 18px ui-monospace, SFMono-Regular, Consolas, monospace; }

  .world-room { position: absolute; top: var(--room-y); left: var(--room-x); width: 340px; transform: translate(-50%, -100%); transform-origin: bottom center; }
  .world-room__shadow { position: absolute; right: 20px; bottom: -30px; left: 30px; height: 55px; background: rgba(0, 0, 0, 0.34); filter: blur(2px); transform: skewX(-28deg); }
  .world-room__building { position: relative; z-index: 1; }
  .world-room__roof { width: 278px; height: 80px; margin: 0 auto -2px; border: 5px solid color-mix(in srgb, var(--world-ink) 70%, transparent); background: var(--room-accent); clip-path: polygon(50% 0, 100% 55%, 91% 100%, 9% 100%, 0 55%); box-shadow: inset 0 -13px 0 rgba(0, 0, 0, 0.18); }
  .world-room__body { position: relative; width: 312px; height: 176px; margin: 0 auto; padding: 10px; border: 5px solid color-mix(in srgb, var(--world-ink) 70%, transparent); background: var(--world-paper-deep); box-shadow: inset 0 -15px 0 rgba(0, 0, 0, 0.16); }
  .world-room__image-frame { position: relative; width: 100%; height: 100%; overflow: hidden; border: 4px solid color-mix(in srgb, var(--world-ink) 56%, transparent); background: #172019; }
  .world-room__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; image-rendering: auto; }
  .world-room__image--dark { display: block; }
  .world-room__image--light { display: none; }
  html[data-theme-type="light"] .world-room__image--dark { display: none; }
  html[data-theme-type="light"] .world-room__image--light { display: block; }
  .world-room__window { position: absolute; right: 18px; bottom: 20px; width: 28px; height: 36px; border: 4px solid var(--world-ink); background: var(--room-accent); box-shadow: inset 0 0 0 5px color-mix(in srgb, var(--world-paper) 40%, transparent); }
  .world-room__steps { display: grid; gap: 4px; width: 95px; margin: 0 auto; }
  .world-room__steps i { display: block; height: 7px; border: 2px solid color-mix(in srgb, var(--world-ink) 54%, transparent); background: var(--world-paper-deep); }
  .world-room__steps i:nth-child(2) { width: 75px; margin: auto; }
  .world-room__steps i:nth-child(3) { width: 55px; margin: auto; }
  .world-room__label { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-top: 16px; color: var(--world-ink); font: 700 14px ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.08em; text-shadow: 0 2px 0 color-mix(in srgb, var(--world-floor-dark) 40%, transparent); }
  .world-room__label span { color: var(--room-accent); }
  .world-room__label strong { font-size: 12px; font-weight: 500; opacity: 0.72; }

  .world-prop { position: absolute; z-index: 1; }
  .world-prop--tree { width: 150px; height: 190px; }
  .world-prop--tree span { position: absolute; right: 28px; bottom: 0; width: 28px; height: 108px; border: 5px solid #283c2d; background: #5c5136; }
  .world-prop--tree i { position: absolute; top: 0; left: 0; width: 150px; height: 125px; border: 5px solid #283c2d; background: #657d4c; clip-path: polygon(50% 0, 75% 18%, 100% 22%, 84% 45%, 96% 68%, 65% 65%, 50% 100%, 31% 67%, 0 72%, 16% 44%, 1% 20%, 29% 17%); box-shadow: inset 18px -12px 0 rgba(0, 0, 0, 0.15); }
  .world-prop--tree-small { transform: scale(0.72); transform-origin: bottom left; }
  .world-prop--bamboo { width: 190px; height: 250px; }
  .world-prop--bamboo i { position: absolute; bottom: 0; width: 16px; height: 245px; border: 4px solid #304a35; background: #709156; transform-origin: bottom center; }
  .world-prop--bamboo i:nth-child(1) { left: 20px; transform: rotate(-11deg); }
  .world-prop--bamboo i:nth-child(2) { left: 58px; height: 220px; transform: rotate(-5deg); }
  .world-prop--bamboo i:nth-child(3) { left: 97px; height: 260px; transform: rotate(3deg); }
  .world-prop--bamboo i:nth-child(4) { left: 132px; height: 230px; transform: rotate(8deg); }
  .world-prop--bamboo i:nth-child(5) { left: 165px; height: 190px; transform: rotate(15deg); }
  .world-prop--bamboo span { position: absolute; width: 52px; height: 20px; border: 4px solid #304a35; background: #809b5d; }
  .world-prop--bamboo span:nth-of-type(1) { top: 25px; left: 4px; transform: rotate(-22deg); }
  .world-prop--bamboo span:nth-of-type(2) { top: 50px; left: 78px; transform: rotate(24deg); }
  .world-prop--bamboo span:nth-of-type(3) { top: 2px; left: 115px; transform: rotate(-28deg); }
  .world-prop--bamboo span:nth-of-type(4) { top: 82px; left: 132px; transform: rotate(30deg); }
  .world-prop--pond { width: 240px; height: 110px; border: 5px solid #334d4b; border-radius: 50%; background: #6c9a98; box-shadow: inset 0 0 0 10px rgba(255, 255, 255, 0.12), 15px 12px 0 rgba(0, 0, 0, 0.14); transform: rotate(-8deg); }
  .world-prop--pond span { position: absolute; right: 32px; bottom: -28px; color: var(--world-ink); font: 700 14px ui-monospace, SFMono-Regular, Consolas, monospace; }
  .world-prop--stone { width: 100px; height: 80px; }
  .world-prop--stone span { position: absolute; bottom: 0; left: 15px; width: 75px; height: 45px; border: 5px solid #3b4438; background: #7d856c; clip-path: polygon(15% 100%, 0 47%, 30% 10%, 78% 0, 100% 50%, 85% 100%); }
  .world-prop--stone i { position: absolute; bottom: -18px; left: 0; width: 110px; height: 20px; background: rgba(0, 0, 0, 0.2); transform: skewX(-30deg); }

