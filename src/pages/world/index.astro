import BaseLayout from "@/layouts/BaseLayout.astro";

const places = [
  {
    id: "courtyard",
    group: "house",
    number: "01",
    label: "庭院",
    english: "COURTYARD",
    description: "入口、书桌与正在发生的事情",
    light: "/portfolio/bg-light.webp",
    dark: "/portfolio/bg-dark.webp",
    href: "/",
    accent: "#7e9c58",
    x: 350,
    y: 410,
  },
  {
    id: "about",
    group: "house",
    number: "02",
    label: "居士自序",
    english: "ABOUT",
    description: "一封写给来访者的信",
    light: "/portfolio/hero-about-light.webp",
    dark: "/portfolio/hero-about-dark.webp",
    href: "/about/",
    accent: "#bd7e58",
    x: 730,
    y: 250,
  },
  {
    id: "blog",
    group: "writing",
    number: "03",
    label: "博客",
    english: "BLOG",
    description: "从课程、代码到实践记录",
    light: "/portfolio/hero-blog-light.webp",
    dark: "/portfolio/hero-blog-dark.webp",
    href: "/blog/",
    accent: "#7186a3",
    x: 1090,
    y: 370,
  },
  {
    id: "making",
    group: "making",
    number: "04",
    label: "造物录",
    english: "WORKBENCH",
    description: "项目、工具和工程决策",
    light: "/portfolio/hero-build-light.webp",
    dark: "/portfolio/hero-build-dark.webp",
    href: "/chores/making/",
    accent: "#a3914f",
    x: 1430,
    y: 235,
  },
  {
    id: "backyard",
    group: "making",
    number: "05",
    label: "别苑杂务",
    english: "BACKYARD",
    description: "不急着分类的零碎记录",
    light: "/portfolio/hero-work-light.webp",
    dark: "/portfolio/hero-work-dark.webp",
    href: "/backyard/",
    accent: "#668c61",
    x: 1250,
    y: 720,
  },
  {
    id: "garden",
    group: "garden",
    number: "06",
    label: "语义花园",
    english: "SEMANTIC GARDEN",
    description: "内容、项目与想法之间的距离",
    light: "/portfolio/semantic-garden-light.png",
    dark: "/portfolio/semantic-garden-dark.png",
    href: "/chores/garden/",
    accent: "#6c9d59",
    x: 880,
    y: 780,
  },
];

const links = [
  ["M 390 465 C 520 380 610 350 730 305", "house"],
  ["M 760 305 C 880 315 980 340 1090 425", "writing"],
  ["M 1135 385 C 1230 320 1320 285 1430 290", "making"],
  ["M 1430 340 C 1400 490 1340 590 1280 735", "making"],
  ["M 1240 770 C 1120 800 1010 820 905 820", "garden"],
];
---

<BaseLayout
  title="别苑世界"
  description="一张可探索的寒柳别苑 2.5D 像素地图。"
  seoDescription="寒柳别苑的 2.5D 微缩地图，连接博客、造物录、语义花园与居士自序。"
  isIndexed={false}
  immersive={true}
  animateType="fade-up"
>
  <div slot="fullscreen" class="world-page" data-world-root>
    <header class="world-header">
      <a class="world-brand" href="/" aria-label="返回寒柳别苑">
        <span class="world-brand__seal">寒</span>
        <span>
          <strong>寒柳别苑</strong>
          <small>HANLIU BIYUAN / WORLD MAP</small>
        </span>
      </a>
      <a class="world-exit" href="/">返回庭院 <Icon name="lucide:arrow-up-right" /></a>
    </header>

    <main class="world-main">
      <div class="world-toolbar">
        <div class="world-heading">
          <p>一张给自己用的地图</p>
          <h1>别苑地图</h1>
        </div>
        <div class="world-filters" role="tablist" aria-label="地图筛选">
          <button type="button" class="is-active" data-filter="all">总览 <b>06</b></button>
          <button type="button" data-filter="house">庭院 <b>02</b></button>
          <button type="button" data-filter="writing">文字 <b>01</b></button>
          <button type="button" data-filter="making">造物 <b>02</b></button>
          <button type="button" data-filter="garden">花园 <b>01</b></button>
        </div>
      </div>

      <section class="world-stage" data-world-stage aria-label="寒柳别苑 2.5D 地图">
        <div class="world-viewport" data-world-viewport>
          <div class="world-canvas" data-world-canvas>
            <svg class="world-terrain" viewBox="0 0 1800 1060" aria-hidden="true">
              <defs>
                <pattern id="pixel-grid" width="32" height="32" patternUnits="userSpaceOnUse">
                  <path d="M32 0H0V32" fill="none" stroke="currentColor" stroke-opacity=".12" stroke-width="1" />
                </pattern>
                <pattern id="pixel-speck" width="11" height="11" patternUnits="userSpaceOnUse">
                  <rect width="2" height="2" x="2" y="2" fill="currentColor" opacity=".12" />
                  <rect width="1" height="1" x="8" y="7" fill="currentColor" opacity=".1" />
                </pattern>
              </defs>
              <polygon class="terrain-shadow" points="180,320 905,70 1630,320 905,1000" />
              <polygon class="terrain-base" points="150,285 900,45 1660,300 900,970" />
              <polygon class="terrain-grid" points="150,285 900,45 1660,300 900,970" fill="url(#pixel-grid)" />
              <polygon class="terrain-speck" points="150,285 900,45 1660,300 900,970" fill="url(#pixel-speck)" />
              <path class="terrain-river" d="M70 620 C230 570 300 700 440 640 S680 570 790 650 S1060 760 1180 665 S1450 555 1740 630" />
              <path class="terrain-river-highlight" d="M70 608 C230 558 300 688 440 628 S680 558 790 638 S1060 748 1180 653 S1450 543 1740 618" />
              {links.map(([d, group]) => <path class={`route route--${group}`} d={d} data-route-group={group} />)}
              <path class="main-route" d="M365 470 C520 405 650 350 760 300 C900 300 1025 350 1120 425 C1250 335 1335 290 1455 295 C1430 465 1345 635 1265 755 C1120 805 1015 820 875 820" />
            </svg>

            <div class="world-map-title">
              <span>STATIC EXPLORATION MAP</span>
              <strong>在这里，内容不是列表<br />而是一片彼此相望的地方。</strong>
            </div>

            <div class="map-tree map-tree--a"></div>
            <div class="map-tree map-tree--b"></div>
            <div class="map-tree map-tree--c"></div>
            <div class="map-bamboo"></div>
            <div class="map-water-lantern"></div>
            <div class="map-stone map-stone--a"></div>
            <div class="map-stone map-stone--b"></div>

            {places.map((place) => (
              <article
                class="map-place"
                data-world-place={place.id}
                data-group={place.group}
                style={`--place-x:${place.x}px;--place-y:${place.y}px;--place-accent:${place.accent};`}
              >
                <div class="map-place__shadow"></div>
                <div class="map-place__sprite">
                  <div class="map-place__top"></div>
                  <div class="map-place__front">
                    <div class="map-place__image-frame">
                      <img class="map-place__image map-place__image--dark" src={place.dark} alt="" decoding="async" />
                      <img class="map-place__image map-place__image--light" src={place.light} alt="" decoding="async" />
                    </div>
                  </div>
                  <div class="map-place__side"></div>
                  <span class="map-place__door"></span>
                </div>
                <a class="map-place__label" href={place.href}>
                  <span class="map-place__tag">{place.number} · {place.english}</span>
                  <strong>{place.label}</strong>
                  <small>{place.description}</small>
                  <Icon name="lucide:arrow-up-right" />
                </a>
              </article>
            ))}

            <div class="map-compass" aria-hidden="true">
              <span>N</span><i></i><b></b><em>E</em><strong>S</strong><small>W</small>
            </div>
          </div>
        </div>
        <div class="world-stage__hint">拖动地图 · 滚轮缩放 · 点击地标</div>
        <button class="world-reset" type="button" data-world-reset>重置视野</button>
      </section>

      <div class="world-legend">
        <div><span class="legend-symbol legend-symbol--house"></span>内容地点</div>
        <div><span class="legend-symbol legend-symbol--path"></span>常走的路</div>
        <div><span class="legend-symbol legend-symbol--garden"></span>正在生长</div>
        <span class="world-legend__note">一张非导航地图 · 只是为了记住它们彼此相邻</span>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  const mountWorldMap = () => {
    const root = document.querySelector("[data-world-root]");
    const stage = root?.querySelector<HTMLElement>("[data-world-stage]");
    const viewport = root?.querySelector<HTMLElement>("[data-world-viewport]");
    const canvas = root?.querySelector<HTMLElement>("[data-world-canvas]");
    const reset = root?.querySelector<HTMLButtonElement>("[data-world-reset]");
    const filterButtons = root ? [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")] : [];
    const places = root ? [...root.querySelectorAll<HTMLElement>("[data-world-place]")] : [];
    const routes = root ? [...root.querySelectorAll<SVGPathElement>("[data-route-group]")] : [];

    if (!root || !stage || !viewport || !canvas) return;

    const mapWidth = 1800;
    const mapHeight = 1060;
    let scale = 1;
    let x = 0;
    let y = 0;
    let dragging = false;
    let startX = 0;
    let startY = 0;
    let originX = 0;
    let originY = 0;

    const applyTransform = () => {
      canvas.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${scale})`;
    };

    const fitMap = () => {
      const rect = viewport.getBoundingClientRect();
      const padding = window.innerWidth < 700 ? 24 : 56;
      scale = Math.min((rect.width - padding) / mapWidth, (rect.height - padding) / mapHeight);
      scale = Math.min(Math.max(scale, 0.42), 1);
      x = (rect.width - mapWidth * scale) / 2;
      y = (rect.height - mapHeight * scale) / 2;
      applyTransform();
    };

    const clampZoom = (nextScale: number) => Math.min(Math.max(nextScale, 0.42), 1.7);

    const zoomAt = (nextScale: number, pointerX: number, pointerY: number) => {
      const previousScale = scale;
      scale = clampZoom(nextScale);
      const ratio = scale / previousScale;
      x = pointerX - (pointerX - x) * ratio;
      y = pointerY - (pointerY - y) * ratio;
      applyTransform();
    };

    const pointerDown = (event: PointerEvent) => {
      if ((event.target as HTMLElement).closest("a,button")) return;
      dragging = true;
      startX = event.clientX;
      startY = event.clientY;
      originX = x;
      originY = y;
      stage.setPointerCapture(event.pointerId);
      stage.classList.add("is-dragging");
    };

    const pointerMove = (event: PointerEvent) => {
      if (!dragging) return;
      x = originX + event.clientX - startX;
      y = originY + event.clientY - startY;
      applyTransform();
    };

    const pointerUp = (event: PointerEvent) => {
      dragging = false;
      if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);
      stage.classList.remove("is-dragging");
    };

    stage.addEventListener("pointerdown", pointerDown);
    stage.addEventListener("pointermove", pointerMove);
    stage.addEventListener("pointerup", pointerUp);
    stage.addEventListener("pointercancel", pointerUp);
    stage.addEventListener("wheel", (event) => {
      event.preventDefault();
      const rect = viewport.getBoundingClientRect();
      zoomAt(scale * (event.deltaY > 0 ? 0.92 : 1.08), event.clientX - rect.left, event.clientY - rect.top);
    }, { passive: false });

    reset?.addEventListener("click", fitMap);
    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter || "all";
        filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
        places.forEach((place) => place.toggleAttribute("data-dimmed", filter !== "all" && place.dataset.group !== filter));
        routes.forEach((route) => route.toggleAttribute("data-dimmed", filter !== "all" && route.dataset.routeGroup !== filter));
      });
    });

    window.addEventListener("resize", fitMap, { passive: true });
    fitMap();
  };

  document.addEventListener("astro:page-load", mountWorldMap);
  mountWorldMap();
</script>

<style is:global>
  :root {
    --world-ink: #263025;
    --world-paper: #f1f3e8;
    --world-map: #b7c99d;
    --world-map-dark: #27382c;
    --world-map-line: rgba(38, 48, 37, 0.42);
    --world-label: #f5f1d8;
  }

  html[data-theme-type="dark"] {
    --world-ink: #e6ebdf;
    --world-paper: #111713;
    --world-map: #304a35;
    --world-map-dark: #111a14;
    --world-map-line: rgba(230, 235, 223, 0.36);
    --world-label: #e6e8d1;
  }

  .world-page { min-height: 100vh; overflow: hidden; color: var(--world-ink); background: var(--world-paper); }
  .world-header { position: fixed; z-index: 30; inset: 0 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 1rem clamp(1rem, 4vw, 4rem); pointer-events: none; }
  .world-header > * { pointer-events: auto; }
  .world-brand, .world-exit { color: inherit; text-decoration: none; }
  .world-brand { display: inline-flex; align-items: center; gap: 0.7rem; }
  .world-brand__seal { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border: 2px solid currentColor; background: var(--world-paper); font-family: serif; font-size: 1.3rem; box-shadow: 4px 4px 0 color-mix(in srgb, var(--world-ink) 22%, transparent); }
  .world-brand strong, .world-brand small { display: block; }
  .world-brand strong { font-size: 0.95rem; letter-spacing: 0.08em; }
  .world-brand small { margin-top: 0.18rem; color: color-mix(in srgb, var(--world-ink) 56%, transparent); font: 0.55rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.13em; }
  .world-exit { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; font-weight: 800; }
  .world-exit svg { width: 1rem; height: 1rem; }
  .world-main { width: min(1500px, 100%); margin: 0 auto; padding: 5.5rem 1rem 1rem; }
  .world-toolbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; padding: 0.5rem 0 1rem; }
  .world-heading p { margin: 0 0 0.3rem; color: color-mix(in srgb, var(--world-ink) 54%, transparent); font: 0.65rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.15em; }
  .world-heading h1 { margin: 0; font-size: clamp(2rem, 4vw, 3.8rem); font-weight: 900; letter-spacing: -0.08em; }
  .world-filters { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.35rem; border: 1px solid color-mix(in srgb, var(--world-ink) 25%, transparent); background: color-mix(in srgb, var(--world-paper) 72%, transparent); }
  .world-filters button { min-width: 6.4rem; padding: 0.7rem 0.8rem; border: 0; color: color-mix(in srgb, var(--world-ink) 62%, transparent); background: transparent; font: 700 0.68rem ui-monospace, SFMono-Regular, Consolas, monospace; text-align: left; cursor: pointer; }
  .world-filters button b { float: right; display: grid; width: 1.4rem; height: 1.4rem; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--world-ink) 13%, transparent); font-size: 0.58rem; }
  .world-filters button.is-active { color: var(--world-label); background: var(--world-map-dark); }
  .world-filters button.is-active b { background: rgba(255,255,255,0.16); }
  .world-stage { position: relative; height: min(72vh, 800px); min-height: 520px; overflow: hidden; border: 6px solid var(--world-map-dark); background: var(--world-map-dark); cursor: grab; touch-action: none; user-select: none; }
  .world-stage.is-dragging { cursor: grabbing; }
  .world-viewport { position: absolute; inset: 0; overflow: hidden; }
  .world-canvas { position: absolute; top: 0; left: 0; width: 1800px; height: 1060px; transform-origin: 0 0; will-change: transform; }
  .world-terrain { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--world-ink); }
  .terrain-shadow { fill: rgba(0, 0, 0, 0.28); transform: translate(0 20px); }
  .terrain-base { fill: var(--world-map); stroke: color-mix(in srgb, var(--world-ink) 43%, transparent); stroke-width: 7; }
  .terrain-grid { fill: url(#pixel-grid); color: var(--world-ink); }
  .terrain-speck { fill: url(#pixel-speck); color: var(--world-ink); }
  .terrain-river { fill: none; stroke: #4b837b; stroke-width: 55; stroke-linecap: square; }
  .terrain-river-highlight { fill: none; stroke: #7db1a1; stroke-width: 17; stroke-dasharray: 3 17; }
  html[data-theme-type="dark"] .terrain-river { stroke: #2b5b55; }
  html[data-theme-type="dark"] .terrain-river-highlight { stroke: #4f8c78; }
  .route { fill: none; stroke: #d1a96c; stroke-width: 19; stroke-linecap: square; stroke-dasharray: 3 14; opacity: 0.72; }
  .main-route { fill: none; stroke: #f0d89a; stroke-width: 10; stroke-linecap: square; stroke-dasharray: 2 12; opacity: 0.85; }
  html[data-theme-type="dark"] .route { stroke: #9b8050; }
  html[data-theme-type="dark"] .main-route { stroke: #d1b873; }
  .route[data-dimmed], .map-place[data-dimmed] { opacity: 0.2; }
  .world-map-title { position: absolute; z-index: 4; top: 100px; left: 700px; width: 370px; padding: 1rem 1.25rem; border: 2px solid var(--world-ink); background: var(--world-label); color: #302e25; box-shadow: 8px 8px 0 rgba(0,0,0,0.18); transform: rotate(-1deg); }
  .world-map-title span { display: block; margin-bottom: 0.6rem; font: 0.58rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.15em; opacity: 0.62; }
  .world-map-title strong { font-size: 1.25rem; line-height: 1.35; }
  .map-place { position: absolute; z-index: 8; top: var(--place-y); left: var(--place-x); width: 275px; transition: opacity 180ms ease, filter 180ms ease; }
  .map-place__shadow { position: absolute; right: 15px; bottom: 42px; left: 20px; height: 48px; background: rgba(0,0,0,0.28); transform: skewX(-28deg); }
  .map-place__sprite { position: relative; height: 170px; }
  .map-place__top { position: absolute; top: 0; left: 28px; width: 210px; height: 82px; border: 4px solid var(--world-ink); background: var(--place-accent); clip-path: polygon(50% 0, 100% 48%, 50% 100%, 0 48%); box-shadow: inset 0 -11px 0 rgba(0,0,0,0.16); }
  .map-place__front { position: absolute; top: 42px; left: 28px; width: 210px; height: 118px; padding: 7px; border: 4px solid var(--world-ink); background: var(--world-label); }
  .map-place__side { position: absolute; top: 42px; left: 238px; width: 28px; height: 118px; border: 4px solid var(--world-ink); background: color-mix(in srgb, var(--place-accent) 58%, #27382c); clip-path: polygon(0 0, 100% 10%, 100% 100%, 0 90%); }
  .map-place__image-frame { position: relative; width: 100%; height: 100%; overflow: hidden; border: 3px solid color-mix(in srgb, var(--world-ink) 75%, transparent); background: #172019; }
  .map-place__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; image-rendering: auto; }
  .map-place__image--dark { display: block; }
  .map-place__image--light { display: none; }
  html[data-theme-type="light"] .map-place__image--dark { display: none; }
  html[data-theme-type="light"] .map-place__image--light { display: block; }
  .map-place__door { position: absolute; bottom: 0; left: 112px; z-index: 2; width: 30px; height: 42px; border: 4px solid var(--world-ink); background: var(--place-accent); }
  .map-place__label { position: absolute; top: -46px; left: 12px; display: grid; grid-template-columns: 1fr auto; gap: 0.18rem 0.7rem; width: 245px; padding: 0.5rem 0.7rem; border: 2px solid #6d6146; background: var(--world-label); color: #302e25; box-shadow: 5px 5px 0 rgba(0,0,0,0.18); text-decoration: none; }
  .map-place__label::after { position: absolute; bottom: -10px; left: 18px; width: 16px; height: 16px; border-right: 2px solid #6d6146; border-bottom: 2px solid #6d6146; background: var(--world-label); content: ""; transform: rotate(45deg); }
  .map-place__tag { grid-column: 1 / -1; color: var(--place-accent); font: 0.54rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 0.12em; }
  .map-place__label strong { font-size: 1rem; font-weight: 900; }
  .map-place__label small { grid-column: 1 / -1; color: #716b59; font-size: 0.62rem; }
  .map-place__label svg { grid-column: 2; grid-row: 2; width: 1rem; height: 1rem; align-self: center; }
  .map-tree, .map-bamboo, .map-water-lantern, .map-stone { position: absolute; z-index: 5; pointer-events: none; }
  .map-tree { width: 96px; height: 128px; }
  .map-tree::before { position: absolute; right: 30px; bottom: 0; width: 18px; height: 70px; border: 3px solid #334a32; background: #7f6246; content: ""; }
  .map-tree::after { position: absolute; top: 0; left: 0; width: 96px; height: 80px; border: 3px solid #334a32; background: #759358; clip-path: polygon(49% 0, 76% 20%, 100% 26%, 83% 52%, 96% 78%, 64% 71%, 50% 100%, 32% 74%, 0 80%, 17% 51%, 1% 24%, 29% 18%); }
  .map-tree--a { top: 215px; left: 190px; }
  .map-tree--b { top: 685px; left: 540px; transform: scale(0.72); }
  .map-tree--c { top: 665px; right: 105px; transform: scale(0.86); }
  .map-bamboo { top: 600px; left: 185px; width: 135px; height: 150px; border-left: 12px solid #466342; border-right: 12px solid #6a884d; transform: skewX(-7deg); box-shadow: 42px 0 0 #789259, 82px 12px 0 #4a6b43; }
  .map-bamboo::after { position: absolute; top: -8px; left: -22px; width: 170px; height: 110px; background: radial-gradient(ellipse at 30% 35%, #7c9958 0 10%, transparent 11%), radial-gradient(ellipse at 73% 54%, #5c7c4e 0 12%, transparent 13%), radial-gradient(ellipse at 38% 80%, #587449 0 12%, transparent 13%); content: ""; }
  .map-water-lantern { right: 220px; bottom: 215px; width: 20px; height: 46px; border: 3px solid #404436; background: #d0ac62; box-shadow: 11px 12px 0 -4px #4b5541; }
  .map-stone { width: 58px; height: 34px; border: 3px solid #485444; background: #89947b; clip-path: polygon(8% 100%, 0 45%, 25% 12%, 72% 0, 100% 44%, 86% 100%); }
