---
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllPosts } from "@/utils/blogUtils";

const allPosts = await getAllPosts();

const featuredProjects = allPosts
  .filter((post) => post.data.workSection === "case-study" && post.data.project)
  .sort((a, b) => a.data.project!.order - b.data.project!.order);

const experimentPosts = allPosts
  .filter((post) => post.data.workSection === "experiment")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const products = [
  ...featuredProjects.map((post) => ({ post, kind: "产品" as const })),
  ...experimentPosts.map((post) => ({ post, kind: "实验" as const })),
];
---

<BaseLayout
  title="造物录"
  description="项目与实验。"
>
  <section class="rounded-2xl border border-base-300 bg-base-100/85 p-4 shadow-lg sm:p-6" aria-labelledby="making-title">
    <div class="mb-6 flex items-end justify-between gap-4 border-b border-base-300 pb-5">
      <h1 id="making-title" class="text-3xl font-black tracking-tight sm:text-4xl">造物录</h1>
      <span class="font-mono text-xs uppercase tracking-[0.18em] text-base-content/45">{products.length} projects</span>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {products.map(({ post, kind }, index) => {
        const project = post.data.project;
        const projectUrl = project?.demo ?? project?.source ?? post.data.link;
        const projectLabel = project?.demo ? "在线体验" : project?.source ? "查看源码" : "打开项目";

        return (
          <ProductCard
            title={post.data.title}
            description={post.data.description}
            image={post.data.image}
            tags={post.data.tags}
            kind={kind}
            date={post.data.pubDate}
            articleUrl={`/blog/${post.slug}/`}
            projectUrl={projectUrl}
            projectLabel={projectLabel}
            priority={index === 0}
          />
        );
      })}
    </div>
  </section>
</BaseLayout>
