---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  image?: string;
  tags?: string[];
  kind: "产品" | "实验";
  date: Date;
  articleUrl: string;
  projectUrl?: string;
  projectLabel?: string;
  priority?: boolean;
}

const {
  title,
  description,
  image,
  tags = [],
  kind,
  date,
  articleUrl,
  projectUrl,
  projectLabel = "打开项目",
  priority = false,
} = Astro.props;

const year = date.getFullYear();
---

<article class="product-card group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100">
  <a href={projectUrl ?? articleUrl} class="block" aria-label={`打开 ${title}`}>
    <div class="relative aspect-[16/10] overflow-hidden bg-base-200">
      {image ? (
        <img
          src={image}
          alt={`${title} 封面`}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : "auto"}
        />
      ) : (
        <div class="flex h-full items-center justify-center bg-gradient-to-br from-primary/20 via-base-200 to-secondary/20">
          <Icon name="lucide:box" class="h-10 w-10 text-primary/60" aria-hidden="true" />
        </div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
      <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between gap-3 text-xs font-medium text-white">
        <span class="rounded-full border border-white/25 bg-black/35 px-2.5 py-1 backdrop-blur-sm">{kind}</span>
        <span class="font-mono text-white/75">{year}</span>
      </div>
    </div>
  </a>

  <div class="flex flex-1 flex-col p-5">
    <h2 class="text-xl font-bold leading-tight transition-colors group-hover:text-primary">{title}</h2>
    <p class="mt-3 line-clamp-3 text-sm leading-6 text-base-content/65">{description}</p>

    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.slice(0, 4).map((tag) => <span class="badge badge-sm badge-outline">{tag}</span>)}
      </div>
    )}

    <div class="mt-5 flex flex-wrap items-center gap-2 pt-1">
      {projectUrl && (
        <a href={projectUrl} class="btn btn-sm min-h-11 btn-primary gap-1.5" target={projectUrl.startsWith("http") ? "_blank" : undefined} rel={projectUrl.startsWith("http") ? "noopener noreferrer" : undefined}>
          {projectLabel}
          <Icon name={projectUrl.startsWith("http") ? "lucide:external-link" : "lucide:arrow-right"} class="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      )}
      <a href={articleUrl} class="btn btn-sm min-h-11 btn-ghost gap-1.5">
        项目记录
        <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5" aria-hidden="true" />
      </a>
    </div>
  </div>
</article>

<style>
  .product-card {
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .product-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, oklch(var(--p)) 45%, transparent);
    box-shadow: 0 18px 45px rgb(0 0 0 / 0.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card img {
      transition: none;
    }

    .product-card:hover {
      transform: none;
    }
  }
</style>
